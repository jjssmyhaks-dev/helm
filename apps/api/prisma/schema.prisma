datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AgentLayer {
  RESEARCH
  MARKETING
  OPERATIONS
  FINANCE
}

enum AgentStatus {
  IDLE
  WORKING
  WAITING_APPROVAL
  ERROR
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
  AWAITING_APPROVAL
}

enum RiskTier {
  AUTO_EXECUTE
  NOTIFY_AND_ACT
  APPROVAL_REQUIRED
}

enum SignalPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EDITED
  EXPIRED
}

model Founder {
  id                String   @id
  clerkUserId       String   @unique @map("clerk_user_id")
  email             String
  name              String?
  businessName      String?  @map("business_name")
  businessType      String?  @map("business_type")
  industry          String?
  onboardingComplete Boolean @default(false) @map("onboarding_complete")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  agents            Agent[]
  tasks             Task[]
  events            EventSignal[]
  approvals         Approval[]
  connectors        Connector[]
  contextNotes      ContextNote[]
  activityLogs      ActivityLogEntry[]
  notifications     Notification[]
  chatSessions      ChatSession[]
  context           FounderContext?

  @@map("founders")
}

model FounderContext {
  id          String   @id @default(uuid())
  founderId   String   @unique @map("founder_id")
  founder     Founder  @relation(fields: [founderId], references: [id], onDelete: Cascade)
  goals       Json     @default("[]")
  decisions   Json     @default("[]")
  facts       Json     @default("[]")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("founder_context")
}

model Agent {
  id              String      @id @default(uuid())
  founderId       String      @map("founder_id")
  founder         Founder     @relation(fields: [founderId], references: [id], onDelete: Cascade)
  name            String
  layer           AgentLayer
  description     String?
  role            String
  status          AgentStatus @default(IDLE)
  config          Json        @default("{}")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  tasks           Task[]
  activityLogs    ActivityLogEntry[]
  publishedEvents EventSignal[] @relation("PublisherAgent")

  @@map("agents")
}

model Task {
  id              String     @id @default(uuid())
  founderId       String     @map("founder_id")
  founder         Founder    @relation(fields: [founderId], references: [id], onDelete: Cascade)
  assignedAgentId String?    @map("assigned_agent_id")
  assignedAgent   Agent?     @relation(fields: [assignedAgentId], references: [id])
  title           String
  description     String?
  layer           AgentLayer
  status          TaskStatus @default(PENDING)
  riskTier        RiskTier   @default(AUTO_EXECUTE)
  result          Json?
  error           String?
  metadata        Json        @default("{}")
  parentId        String?    @map("parent_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  completedAt     DateTime?  @map("completed_at")

  @@map("tasks")
}

model EventSignal {
  id               String   @id @default(uuid())
  type             String   @map("signal_type")
  payload          Json     @default("{}")

  publisherAgentId String   @map("publisher_agent_id")
  publisherAgent   Agent    @relation("PublisherAgent", fields: [publisherAgentId], references: [id])

  founderId        String   @map("founder_id")
  founder          Founder  @relation(fields: [founderId], references: [id], onDelete: Cascade)

  publishedAt      DateTime @default(now()) @map("published_at")

  @@index([founderId, type])
  @@index([publishedAt])
  @@map("event_signals")
}

model EventSubscription {
  id         String   @id @default(uuid())
  signalType String   @map("signal_type")
  agentId    String   @map("agent_id")
  founderId  String   @map("founder_id")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([signalType, agentId])
  @@map("event_subscriptions")
}

model Approval {
  id          String         @id @default(uuid())
  founderId   String         @map("founder_id")
  founder     Founder        @relation(fields: [founderId], references: [id], onDelete: Cascade)
  agentId     String         @map("agent_id")
  taskId      String?        @map("task_id")
  actionType  String         @map("action_type")
  actionData  Json           @map("action_data")
  reasoning   String?
  riskTier    RiskTier       @default(APPROVAL_REQUIRED)
  status      ApprovalStatus @default(PENDING)
  decision    String?
  edits       Json?
  createdAt   DateTime       @default(now()) @map("created_at")
  decidedAt   DateTime?      @map("decided_at")
  expiresAt   DateTime?      @map("expires_at")

  @@index([founderId, status])
  @@map("approvals")
}

model Connector {
  id              String   @id @default(uuid())
  founderId       String   @map("founder_id")
  founder         Founder  @relation(fields: [founderId], references: [id], onDelete: Cascade)
  name            String
  displayName     String   @map("display_name")
  status          String   @default("disconnected")
  authType        String?  @map("auth_type")
  scopes          Json     @default("[]")
  lastHealthCheck DateTime? @map("last_health_check")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([founderId, name])
  @@map("connectors")
}

model ContextNote {
  id          String   @id @default(uuid())
  founderId   String   @map("founder_id")
  founder     Founder  @relation(fields: [founderId], references: [id], onDelete: Cascade)
  key         String
  value       Json
  category    String   @default("general")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([founderId, key])
  @@map("context_notes")
}

model ActivityLogEntry {
  id          String   @id @default(uuid())
  founderId   String   @map("founder_id")
  founder     Founder  @relation(fields: [founderId], references: [id], onDelete: Cascade)
  agentId     String   @map("agent_id")
  agent       Agent?   @relation(fields: [agentId], references: [id])
  action      String
  details     Json     @default("{}")
  riskTier    RiskTier @default(AUTO_EXECUTE)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([founderId, createdAt])
  @@index([agentId])
  @@map("activity_log")
}

model Notification {
  id          String   @id @default(uuid())
  founderId   String   @map("founder_id")
  founder     Founder  @relation(fields: [founderId], references: [id], onDelete: Cascade)
  type        String
  title       String
  message     String
  priority    String   @default("normal")
  read        Boolean  @default(false)
  data        Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([founderId, read])
  @@map("notifications")
}

model ChatSession {
  id          String   @id @default(uuid())
  founderId   String   @map("founder_id")
  founder     Founder  @relation(fields: [founderId], references: [id], onDelete: Cascade)
  title       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  messages    ChatMessage[]

  @@index([founderId])
  @@map("chat_sessions")
}

model ChatMessage {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String
  content     String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("chat_messages")
}
